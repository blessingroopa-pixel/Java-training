import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();
        int[] arr = new int[N];

        // Read array elements
        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        int X = sc.nextInt();
        int index = -1;

        // Search for X in the array
        for (int i = 0; i < N; i++) {
            if (arr[i] == X) {
                index = i;
                break;
            }
        }

        // Print the index or -1
        System.out.println(index);
    }
}
