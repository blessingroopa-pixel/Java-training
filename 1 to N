import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        for (int t = 0; t < T; t++) {
            int N = sc.nextInt();

            for (int i = 1; i <= N; i++) {
                System.out.print(i + " ");
            }
        }
    }
}
