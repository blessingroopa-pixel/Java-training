import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();
        int[] arr = new int[N];
        int sumEven = 0;

        // Read array elements and calculate sum of even numbers
        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
            if (arr[i] % 2 == 0) {
                sumEven += arr[i];
            }
        }

        // Print the sum of even elements
        System.out.println(sumEven);
    }
}
